#. Plugin Name of the plugin
#: parla.php
msgid "AskParla AI Shopping Assistant for WooCommerce"
msgstr "AskParla AI Shopping Assistant for WooCommerce"

#. Plugin URI of the plugin
#: parla.php
msgid "https://askparla.com"
msgstr "https://askparla.com"

#. Description of the plugin
#: parla.php
msgid "AI shopping and order-support chat for your store: product search, order tracking, address changes and returns."
msgstr "Un chat d’achat et de service client par IA pour votre boutique : recherche de produits, suivi de commande, changement d’adresse et retours."

#. Author of the plugin
#: parla.php
msgid "AskParla"
msgstr "AskParla"

