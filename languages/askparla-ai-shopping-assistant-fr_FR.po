#: includes/admin.php:523
msgid "Parla account"
msgstr "Compte Parla"

#: includes/admin.php:523
msgid "paused"
msgstr "en pause"

#: includes/admin.php:524
msgid "The chat server is up, but your Parla account is paused, so shoppers see a connection error. Choose a plan in your Parla account, or write to us, and it answers again within the minute."
msgstr "Le serveur du chat fonctionne, mais votre compte Parla est en pause : vos clients voient une erreur de connexion. Choisissez une formule dans votre compte Parla, ou écrivez-nous, et le chat répond de nouveau dans la minute."

#. Plugin Name of the plugin
#: parla.php
msgid "AskParla AI Shopping Assistant for WooCommerce"
msgstr "AskParla AI Shopping Assistant for WooCommerce"

#. Plugin URI of the plugin
#: parla.php
msgid "https://askparla.com"
msgstr "https://askparla.com"

#. Description of the plugin
#: parla.php
msgid "AI shopping and order-support chat for your store: product search, order tracking, address changes and returns."
msgstr "Un chat d’achat et de service client par IA pour votre boutique : recherche de produits, suivi de commande, changement d’adresse et retours."

#. Author of the plugin
#: parla.php
msgid "AskParla"
msgstr "AskParla"

#. translators: %d: the HTTP status code the server returned
#: includes/admin.php:39
#: parla.php:983
#, php-format
msgid "the server answered %d"
msgstr "le serveur a répondu %d"

