msgid "%1$s did not answer (%2$s). Shoppers see a connection error until it is back."
msgstr "%1$s n’a pas répondu (%2$s). Les clients voient une erreur de connexion jusqu’à son retour."

#: includes/admin.php:367
msgid "answering"
msgstr "répond"

