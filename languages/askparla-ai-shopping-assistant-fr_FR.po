msgstr "%1$s demandes différentes, posées %2$s fois"

#. translators: %s: distinct things asked
#: includes/admin.php:235
#, php-format
msgid "%s thing asked"
msgid_plural "%s different things asked"
msgstr[0] "%s demande"
msgstr[1] "%s demandes différentes"

#: includes/admin.php:251
#: includes/admin.php:890
#: includes/waiting.php:280
#: includes/waiting.php:293
msgid "Show fewer"
