msgstr "Les %s plus fréquentes sont affichées. Les autres sont dans votre espace Parla."

#: includes/admin.php:280
msgid "Sales it helped with"
msgstr "Ventes auxquelles il a contribué"

#: includes/admin.php:281
msgid "Last 30 days"
msgstr "30 derniers jours"

#: includes/admin.php:285
msgid "No orders yet from shoppers who talked to the assistant. An order counts when it is placed within 7 days of a chat or a call."
msgstr "Aucune commande pour l’instant de clients ayant parlé à l’assistant. Une commande compte si elle est passée dans les 7 jours qui suivent un échange écrit ou un appel."

#. translators: 1: number of orders, 2: share of the shop's sales in percent
#: includes/admin.php:295
#, php-format
msgid "from %1$d order, %2$d%% of your sales"
msgid_plural "from %1$d orders, %2$d%% of your sales"
msgstr[0] "sur %1$d commande, %2$d %% de vos ventes"
msgstr[1] "sur %1$d commandes, %2$d %% de vos ventes"

#. translators: %d: number of items
#: includes/admin.php:308
#, php-format
msgid "%d item it put in the cart itself"
msgid_plural "%d items it put in the cart itself"
msgstr[0] "%d article ajouté au panier par l’assistant"
msgstr[1] "%d articles ajoutés au panier par l’assistant"

#. translators: %s: average order without the assistant
#: includes/admin.php:319
#, php-format
msgid "average order, against %s without it"
msgstr "panier moyen, contre %s sans lui"

#: includes/admin.php:327
msgid "Paid orders, refunds taken off. Counted here from your own WooCommerce orders; nothing about them is sent anywhere."
msgstr "Commandes payées, remboursements déduits. Calculé ici à partir de vos propres commandes WooCommerce ; rien n’en est envoyé ailleurs."

#: includes/admin.php:329
msgid " Only your latest 3,000 orders are counted."
msgstr " Seules vos 3 000 dernières commandes sont prises en compte."

